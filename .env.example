# Optional. If these are empty, the contact form opens a mailto: to Swapno.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# PostHog (public project token). Leave empty to disable analytics locally.
# The token is a frontend key; still do not commit a filled .env.
VITE_PUBLIC_POSTHOG_KEY=phc_...
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
